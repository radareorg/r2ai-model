"""Friendly command-line front door for r2ai-model workflows."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT_MARKERS = ("memory.py", "agentic-dataset.py")
MEMORY_TOPICS = Path("data/memory/topics.jsonl")
MEMORY_ROWS = Path("data/memory/memory.jsonl")
MEMORY_TRAINING = Path("data/memory/verified.jsonl")
COMMAND_ROWS = Path("data/agentic-commands/commands.jsonl")
COMMAND_TRAINING = Path("data/agentic-commands/verified.jsonl")
COMMAND_INDEX = Path("data/agentic-commands/index.json")
KNOWLEDGE_ROWS = Path("data/agentic-knowledge/knowledge.jsonl")
MERGED_DATASET = Path("data/training/radare2_all_agentic_train.jsonl")
LEGACY_PENDING = Path("data/radare2/pending/claude-numbers2.tsv")
PENDING_PATHS = (
    Path("data/radare2-agentic/pending-human.jsonl"),
    Path("data/r2js/pending-human.jsonl"),
    Path("data/reasoning-long/pending-human.jsonl"),
    Path("data/agentic-knowledge/pending-human.jsonl"),
)
DATASET_SOURCES = (
    Path("data/radare2/function_calling_r2cmd_dataset.jsonl"),
    Path("data/radare2/radare2_train.jsonl"),
    Path("data/radare2-agentic/verified.jsonl"),
    Path("data/r2js/verified.jsonl"),
    Path("data/reasoning-long/verified.jsonl"),
    KNOWLEDGE_ROWS,
    COMMAND_TRAINING,
    MEMORY_TRAINING,
)
PRESETS = {
    "qwen": ("config.yaml", "output", "radare2-qwen3-4b-finetuned.gguf"),
    "minicpm5": ("config.minicpm5.yaml", "output-minicpm5", "radare2-minicpm5-1b-finetuned.gguf"),
    "lfm25": ("config.lfm2.5.yaml", "output-lfm2.5", "radare2-lfm2.5-1.2b-finetuned.gguf"),
}
INTERNAL_ARGS = {"command", "func", "action", "extra", "full", "preset", "create_only"}

EXAMPLES = """
Common workflows:
  r2ai-model status
  r2ai-model datasets --check
  r2ai-model commands --ai off --no-queue-memory
  r2ai-model review
  r2ai-model merge
  r2ai-model preflight --preset qwen
  r2ai-model train --preset minicpm5
  r2ai-model chat --preset qwen
  r2ai-model serve --preset qwen --port 8080
  r2ai-model help commands
""".strip()


def find_root(start: Path) -> Path | None:
    try:
        current = start.expanduser().resolve()
    except OSError:
        current = start.expanduser().absolute()
    current = current.parent if current.is_file() else current
    return next((path for path in (current, *current.parents) if all((path / marker).is_file() for marker in ROOT_MARKERS)), None)


def resolve_root() -> Path:
    candidates = [Path(__file__), Path(os.environ["R2AI_MODEL_ROOT"])] if os.environ.get("R2AI_MODEL_ROOT") else [Path(__file__)]
    candidates.append(Path.cwd())
    root = next((found for candidate in candidates if (found := find_root(candidate))), None)
    if root:
        return root
    raise SystemExit("Cannot locate r2ai-model checkout. Set R2AI_MODEL_ROOT=/path/to/r2ai-model.")


ROOT = resolve_root()


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads((ROOT / path).read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    full_path = ROOT / path
    if not full_path.is_file():
        return []
    rows = []
    for lineno, line in enumerate(full_path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"invalid JSONL in {path}:{lineno}") from exc
        if isinstance(value, dict):
            rows.append(value)
    return rows


def run(command: list[str], cwd: Path = ROOT) -> int:
    return subprocess.call(command, cwd=cwd)


def run_python(script: str, args: list[str]) -> int:
    return run([sys.executable, str(ROOT / script), *args])


def run_make(target: str, *, training: bool = False, variables: dict[str, Any] | None = None, extra: list[str] | None = None) -> int:
    command = ["make"]
    if training:
        command += ["-C", "training"]
    command.append(target)
    command += [f"{key}={value}" for key, value in (variables or {}).items() if value not in (None, "", 0)]
    command += strip_separator(extra or [])
    return run(command)


def strip_separator(values: list[str]) -> list[str]:
    return values[1:] if values[:1] == ["--"] else values


def forwarded(args: argparse.Namespace, *skip: str) -> list[str]:
    result = []
    for name, value in vars(args).items():
        if name in INTERNAL_ARGS or name in skip or value is None or value is False or value in ("", []):
            continue
        flag = "--" + name.replace("_", "-")
        if isinstance(value, bool):
            result.append(flag)
        elif isinstance(value, list):
            for item in value:
                result += [flag, str(item)]
        else:
            result += [flag, str(value)]
    for name in ("queue_memory",):
        if getattr(args, name, None) is False:
            result.append("--no-" + name.replace("_", "-"))
    return result + strip_separator(getattr(args, "extra", []))


def pending_memory() -> list[dict[str, Any]]:
    return [row for row in read_jsonl(MEMORY_TOPICS) if row.get("status") == "pending"]


def cmd_memory(args: argparse.Namespace) -> int:
    positionals = [args.topic] if args.action == "add-topic" else []
    return run_python("memory.py", [args.action, *positionals, *forwarded(args, "topic")])


def cmd_agentic(args: argparse.Namespace) -> int:
    options = forwarded(args)
    if args.command == "learn" and not args.full:
        options.insert(0, "--skip-seeds")
    return run_python("agentic-dataset.py", [args.action, *options])


def preset_values(args: argparse.Namespace) -> tuple[str, str]:
    if args.config and args.preset:
        raise SystemExit("use either --config or --preset, not both")
    if args.preset:
        config, _output, gguf = PRESETS[args.preset]
        return config, gguf
    return args.config, ""


def cmd_model_task(args: argparse.Namespace) -> int:
    config, _gguf = preset_values(args)
    variables = {"CONFIG": config, "MERGED_DATASET": getattr(args, "merged_dataset", "")}
    return run_make(args.action, variables=variables)


def inference_model(args: argparse.Namespace) -> str:
    if args.model and args.preset:
        raise SystemExit("use either --model or --preset, not both")
    return args.model or (PRESETS[args.preset][2] if args.preset else "")


def cmd_chat(args: argparse.Namespace) -> int:
    model = inference_model(args)
    if args.create_only and args.backend != "ollama":
        raise SystemExit("--create-only applies only to the Ollama backend")
    variables = {
        "MODEL": model, "OLLAMA_MODEL": args.name, "LLAMA_CTX": args.context,
        "LLAMA_CLI": args.llama_cli, "LLAMA_ARGS": " ".join(args.llama_args),
    }
    target = "llama-chat" if args.backend == "llama.cpp" else ("ollama-create" if args.create_only else "chat")
    return run_make(target, training=args.backend == "llama.cpp" or args.create_only, variables=variables)


def cmd_serve(args: argparse.Namespace) -> int:
    variables = {
        "MODEL": inference_model(args), "LLAMA_CTX": args.context, "LLAMA_HOST": args.host,
        "LLAMA_PORT": args.port, "LLAMA_ARGS": " ".join(args.llama_args), "LLAMA_SERVER": args.server,
        "LLAMA_LIBRARY_PATH": args.library_path,
    }
    return run_make("serve", variables=variables)


def cmd_dataset_task(args: argparse.Namespace) -> int:
    variables = {"MERGED_DATASET": getattr(args, "output", "")}
    return run_make(args.action, training=True, variables=variables)


def cmd_clean(args: argparse.Namespace) -> int:
    if args.dry_run:
        print("would remove training/{venv,output,output-minicpm5,output-lfm2.5,__pycache__,*.pyc}")
        return 0
    return run_make("clean", training=True)


def cmd_review(args: argparse.Namespace) -> int:
    queue = args.queue
    legacy = Path(args.file) if Path(args.file).is_absolute() else ROOT / args.file
    if queue == "auto":
        if sum(len(read_jsonl(path)) for path in PENDING_PATHS):
            queue = "agentic"
        elif pending_memory():
            queue = "memory"
        elif legacy.is_file() and legacy.stat().st_size:
            queue = "legacy"
        else:
            print("no pending review tasks")
            return 0
    if queue == "memory":
        command = ["list"] + (["--all"] if args.all else []) if args.list else ["ask", "--source", args.source]
        return run_python("memory.py", command)
    if queue == "agentic":
        command = ["pending"] + (["--list"] if args.list else [])
        return run_python("agentic-dataset.py", command)
    if not legacy.is_file():
        print(f"legacy review file not found: {legacy}", file=sys.stderr)
        return 1
    if args.list:
        count = sum(1 for line in legacy.read_text(encoding="utf-8").splitlines() if line.strip())
        print(f"{count} legacy rows in {legacy}")
        return 0
    return run([str(ROOT / "review-pending.sh"), str(legacy)])


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def dataset_payload() -> dict[str, Any]:
    sources = []
    newest = 0.0
    for path in DATASET_SOURCES:
        full = ROOT / path
        mtime = full.stat().st_mtime if full.is_file() else 0.0
        newest = max(newest, mtime)
        sources.append({"path": str(path), "rows": len(read_jsonl(path)), "exists": full.is_file(), "mtime": mtime})
    merged = ROOT / MERGED_DATASET
    merged_mtime = merged.stat().st_mtime if merged.is_file() else 0.0
    return {
        "sources": sources,
        "source_rows": sum(item["rows"] for item in sources),
        "merged": {"path": str(MERGED_DATASET), "rows": len(read_jsonl(MERGED_DATASET)), "exists": merged.is_file(), "mtime": merged_mtime},
        "stale": not merged.is_file() or merged_mtime < newest,
    }


def artifact_payload(merged_hash: str) -> dict[str, Any]:
    artifacts = {}
    for name, (config, output, gguf) in PRESETS.items():
        metadata = read_json(Path("training") / output / "training_metadata.json")
        final_model = Path(metadata.get("final_model_path") or ROOT / "training" / output / "final_model")
        gguf_path = Path(metadata.get("gguf_path") or ROOT / "training" / gguf)
        dataset_match = bool(merged_hash and metadata.get("dataset_sha256") == merged_hash)
        artifacts[name] = {
            "config": config,
            "trained": final_model.is_dir(),
            "final_model": str(final_model),
            "gguf": str(gguf_path),
            "gguf_exists": gguf_path.is_file(),
            "dataset_match": dataset_match,
            "needs_training": not final_model.is_dir() or not dataset_match,
        }
    return artifacts


def status_payload() -> dict[str, Any]:
    topics, memories = read_jsonl(MEMORY_TOPICS), read_jsonl(MEMORY_ROWS)
    datasets = dataset_payload()
    merged = ROOT / MERGED_DATASET
    index = read_json(COMMAND_INDEX)
    return {
        "root": str(ROOT),
        "memory": {
            "pending": sum(row.get("status") == "pending" for row in topics),
            "answered": sum(row.get("status") == "answered" for row in topics),
            "dropped": sum(row.get("status") == "dropped" for row in topics),
            "accepted_rows": sum(row.get("status") == "accepted" for row in memories),
            "training_rows": len(read_jsonl(MEMORY_TRAINING)),
        },
        "agentic": {
            "knowledge_rows": len(read_jsonl(KNOWLEDGE_ROWS)),
            "pending_rows": sum(len(read_jsonl(path)) for path in PENDING_PATHS),
        },
        "commands": {
            "rows": len(read_jsonl(COMMAND_ROWS)),
            "training_rows": len(read_jsonl(COMMAND_TRAINING)),
            "focused_rows": index.get("focused_command_rows", 0),
            "workflow_rows": index.get("verified_workflow_rows", 0),
        },
        "datasets": datasets,
        "artifacts": artifact_payload(file_sha256(merged) if merged.is_file() else ""),
    }


def print_datasets(payload: dict[str, Any]) -> None:
    for source in payload["sources"]:
        state = "ok" if source["exists"] else "missing"
        print(f"{state:7} {source['rows']:5}  {source['path']}")
    merged = payload["merged"]
    state = "stale" if payload["stale"] else "current"
    print(f"{state:7} {merged['rows']:5}  {merged['path']}")


def cmd_datasets(args: argparse.Namespace) -> int:
    payload = dataset_payload()
    if args.format == "json":
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print_datasets(payload)
    return int(args.check and (payload["stale"] or not all(item["exists"] for item in payload["sources"])))


def cmd_status(args: argparse.Namespace) -> int:
    payload = status_payload()
    if args.format == "json":
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    memory, agentic, commands, datasets = (payload[key] for key in ("memory", "agentic", "commands", "datasets"))
    print(f"root: {payload['root']}")
    print(
        f"memory: {memory['pending']} pending, {memory['answered']} answered, "
        f"{memory['accepted_rows']} accepted, {memory['training_rows']} training rows"
    )
    print(f"agentic: {agentic['knowledge_rows']} knowledge rows, {agentic['pending_rows']} pending rows")
    print(
        f"commands: {commands['rows']} rows, {commands['training_rows']} training, "
        f"{commands['focused_rows']} focused, {commands['workflow_rows']} workflows"
    )
    print(f"datasets: {datasets['merged']['rows']} merged rows ({'stale' if datasets['stale'] else 'current'})")
    for name, artifact in payload["artifacts"].items():
        state = "retrain" if artifact["needs_training"] else ("ready" if artifact["gguf_exists"] else "export")
        print(f"model {name}: {state}; gguf={artifact['gguf']}")
    return 0


def add_extra(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("extra", nargs=argparse.REMAINDER, help="advanced arguments after '--'")


def add_r2_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--r2-bin", default="")
    parser.add_argument("--r2-source", default="")
    parser.add_argument("--timeout", type=int)


def add_build_options(parser: argparse.ArgumentParser) -> None:
    add_r2_options(parser)
    parser.add_argument("--growth-budget", type=int)
    parser.add_argument("--section-budget", type=int)
    parser.add_argument("--online", choices=["auto", "off", "required"], default="")
    parser.add_argument("--online-timeout", type=float)
    parser.add_argument("--discover-fixtures", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    add_extra(parser)


def add_preset(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--preset", choices=PRESETS, default="")
    parser.add_argument("--config", default="", help="config path relative to training/")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="r2ai-model",
        description=__doc__,
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--root", action="store_true", help="print the resolved checkout and exit")
    sub = parser.add_subparsers(dest="command")

    help_parser = sub.add_parser("help", help="show general or command-specific help")
    help_parser.add_argument("topic", nargs="?")

    for name, aliases, action, help_text in (
        ("play", ["ask"], "ask", "answer the next memory prompt interactively"),
        ("answer", ["submit"], "answer-file", "record JSON answers from stdin or a file"),
        ("queue", ["add-topic"], "add-topic", "queue a topic for clarification"),
        ("remember", [], "remember", "record an accepted memory directly"),
        ("list", [], "list", "list memory topics"),
        ("export", [], "export-training", "export accepted memory training rows"),
    ):
        item = sub.add_parser(name, aliases=aliases, help=help_text)
        item.set_defaults(func=cmd_memory, action=action)
        if name == "play":
            item.add_argument("--source", default="terminal")
        elif name == "answer":
            item.add_argument("--file", default="-")
            item.add_argument("--source", default="r2ai-model")
        elif name == "queue":
            item.add_argument("topic")
            item.add_argument("--question", default="")
            item.add_argument("--tags", default="")
            item.add_argument("--source", default="r2ai-model")
        elif name == "remember":
            for required in ("topic", "highlight", "details"):
                item.add_argument("--" + required, required=True)
            item.add_argument("--question", default="")
            item.add_argument("--tags", default="")
            item.add_argument("--source", default="r2ai-model")
        elif name == "list":
            item.add_argument("--all", action="store_true")

    next_parser = sub.add_parser("next", aliases=["prompt", "question"], help="print the next batch-agent memory prompt")
    next_parser.add_argument("--format", choices=["text", "json"], default="text")
    next_parser.set_defaults(func=cmd_memory, action="next")

    commands = sub.add_parser("commands", help="refresh command help and build command/workflow datasets")
    add_r2_options(commands)
    commands.add_argument("--limit", type=int)
    commands.add_argument("--variants-per-block", type=int)
    commands.add_argument("--family-chunk-size", type=int)
    commands.add_argument("--memory-limit", type=int)
    commands.add_argument("--queue-memory", action=argparse.BooleanOptionalAction, default=True)
    commands.add_argument("--ai", choices=["auto", "off", "required"], default="")
    commands.add_argument("--model", default="")
    commands.add_argument("--temperature", type=float)
    add_extra(commands)
    commands.set_defaults(func=cmd_agentic, action="commands")

    learn = sub.add_parser("learn", help="discover and register agentic knowledge")
    learn.add_argument("--full", action="store_true", help="also verify fixed seeds")
    add_build_options(learn)
    learn.set_defaults(func=cmd_agentic, action="build")

    build = sub.add_parser("build", help="build fixed or full agentic datasets")
    build.add_argument("--dataset", choices=["all", "r2cmd", "r2js", "reasoning"], default="")
    build.add_argument("--skip-seeds", action="store_true")
    add_build_options(build)
    build.set_defaults(func=cmd_agentic, action="build")

    verify = sub.add_parser("verify", help="verify executable agentic knowledge")
    add_r2_options(verify)
    verify.add_argument("--limit", type=int)
    verify.add_argument("--id", action="append", default=[])
    verify.add_argument("--verbose", action="store_true")
    add_extra(verify)
    verify.set_defaults(func=cmd_agentic, action="verify-knowledge")

    pending = sub.add_parser("pending", help="review agentic pending rows")
    pending.add_argument("--list", action="store_true")
    pending.add_argument("--response-log", default="")
    pending.add_argument("--r2-source", default="")
    add_extra(pending)
    pending.set_defaults(func=cmd_agentic, action="pending")

    propose = sub.add_parser("propose", help="propose pending rows with an AI model")
    propose.add_argument("--model", default="")
    propose.add_argument("--count", type=int)
    propose.add_argument("--temperature", type=float)
    propose.add_argument("--r2-source", default="")
    add_extra(propose)
    propose.set_defaults(func=cmd_agentic, action="propose")

    review = sub.add_parser("review", help="review memory, agentic, or legacy pending rows")
    review.add_argument("queue", nargs="?", choices=["auto", "memory", "agentic", "legacy"], default="auto")
    review.add_argument("--list", action="store_true")
    review.add_argument("--all", action="store_true", help="include completed memory topics")
    review.add_argument("--file", default=str(LEGACY_PENDING))
    review.add_argument("--source", default="terminal")
    review.set_defaults(func=cmd_review)

    for name, action, help_text in (
        ("compile", "compile-dataset", "compile classic dataset sources"),
        ("merge", "merge-agentic-dataset", "merge every training-ready dataset"),
    ):
        item = sub.add_parser(name, help=help_text)
        if name == "merge":
            item.add_argument("--output", default="", help="merged JSONL path relative to training/")
        item.set_defaults(func=cmd_dataset_task, action=action)

    datasets = sub.add_parser("datasets", help="show source inventory and merged-dataset freshness")
    datasets.add_argument("--format", choices=["text", "json"], default="text")
    datasets.add_argument("--check", action="store_true", help="fail if a source is missing or the merge is stale")
    datasets.set_defaults(func=cmd_datasets)

    for name, action, help_text in (
        ("preflight", "preflight", "merge and validate data without loading model weights"),
        ("train", "train", "merge, fine-tune, and export the selected model"),
    ):
        item = sub.add_parser(name, help=help_text)
        add_preset(item)
        item.add_argument("--merged-dataset", default="")
        item.set_defaults(func=cmd_model_task, action=action)

    chat = sub.add_parser("chat", help="import a GGUF into Ollama and chat")
    chat.add_argument("--model", default="")
    chat.add_argument("--preset", choices=PRESETS, default="")
    chat.add_argument("--name", default="")
    chat.add_argument("--context", type=int, default=0)
    chat.add_argument("--backend", choices=["ollama", "llama.cpp"], default="ollama")
    chat.add_argument("--create-only", action="store_true")
    chat.add_argument("--llama-cli", default="")
    chat.add_argument("--llama-args", nargs=argparse.REMAINDER, default=[], help="remaining llama.cpp arguments; must be last")
    chat.set_defaults(func=cmd_chat)

    serve = sub.add_parser("serve", help="serve a GGUF through llama.cpp")
    serve.add_argument("--model", default="")
    serve.add_argument("--preset", choices=PRESETS, default="")
    serve.add_argument("--context", type=int, default=0)
    serve.add_argument("--host", default="")
    serve.add_argument("--port", type=int, default=0)
    serve.add_argument("--llama-args", nargs=argparse.REMAINDER, default=[], help="remaining llama.cpp arguments; must be last")
    serve.add_argument("--server", default="")
    serve.add_argument("--library-path", default="")
    serve.set_defaults(func=cmd_serve)

    status = sub.add_parser("status", help="show queues, datasets, freshness, and model artifacts")
    status.add_argument("--format", choices=["text", "json"], default="text")
    status.set_defaults(func=cmd_status)

    clean = sub.add_parser("clean", help="remove generated training environments and outputs")
    clean.add_argument("--dry-run", action="store_true")
    clean.set_defaults(func=cmd_clean)

    make = sub.add_parser("make", help="compatibility escape hatch for a Make target")
    make.add_argument("extra", nargs=argparse.REMAINDER)
    make.set_defaults(func=lambda args: run(["make", *strip_separator(args.extra)]))

    help_parser.set_defaults(func=lambda args: print_help(parser, sub, args.topic))
    return parser


def print_help(parser: argparse.ArgumentParser, sub: argparse._SubParsersAction, topic: str | None) -> int:
    if not topic:
        parser.print_help()
        return 0
    choices = sub.choices
    if topic not in choices:
        print(f"unknown command: {topic}", file=sys.stderr)
        return 2
    choices[topic].print_help()
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(sys.argv[1:] if argv is None else argv)
    if args.root:
        print(ROOT)
        return 0
    if not hasattr(args, "func"):
        parser.print_help()
        return 0
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
